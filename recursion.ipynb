   "source": [
    "def hcfcal(a,b):\n",
    "    if(a==0 or b==0):\n",
    "        return(max(a,b))\n",
    "    if(b==1):\n",
    "        return b\n",
    "    if(a%b==0):\n",
    "        return b\n",
    "    return hcfcal(b,a%b)\n",
    "\n",
    "print(hcfcal(max(36,0),min(36,0)))"
   ]
  }
 ],
