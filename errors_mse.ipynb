   "source": [
    "def error(x1,x2,x3,y1,y2,y3,m,c):\n",
    "    yp1=m*x1+c\n",
    "    yp2=m*x2+c\n",
    "    yp3=m*x3+c\n",
    "    diff1=yp1-y1\n",
    "    diff2=yp2-y2\n",
    "    diff3=yp3-y3\n",
    "    error=diff1*diff1+diff2*diff2+diff3*diff3\n",
    "    return error\n",
    "\n",
    "errorcalc=error(1,2,3,2,5,7,2,0.9)\n",
    "print(errorcalc)"
   ]
  }
 ],
